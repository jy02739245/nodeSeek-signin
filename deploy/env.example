# NodeSeek 签到 VPS 配置示例
# 复制为 .env 后填写：cp deploy/env.example .env && chmod 600 .env

# 必填：NodeSeek 登录后的完整 Cookie，多账号用 & 分隔（.env 不支持多行）
NS_COOKIE=

# 可选：VPS 出口 IP 被 Cloudflare 拦截时填写，例如 http://user:pass@127.0.0.1:7890
NS_PROXY=
NS_TIMEOUT=60
NS_IMPERSONATE=chrome136

# ===== 节点代理（可选，VLESS + XHTTP）=====
# 配置后脚本会启动 Xray，把签到请求转到这个节点；优先于 NS_PROXY
# 例：vless://uuid@host:443?type=xhttp&security=reality&pbk=...&fp=chrome&sni=...&path=%2F#name
NODE_LINK=
# 本地代理端口，默认 1082
NS_PROXY_PORT=1082
# Xray 不在 PATH 时指定
# XRAY_PATH=/usr/local/bin/xray

# 运行行为
NS_RANDOM=true
FAIL_ON_ERROR=true

# Telegram 通知（可选）
TG_BOT_TOKEN=
TG_USER_ID=
TG_THREAD_ID=
# 国内 VPS 访问不了 api.telegram.org 时换成自己的反代
TG_API_HOST=https://api.telegram.org
